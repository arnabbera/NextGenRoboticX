{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextgenroboticx",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-17",
  "routes": [
    {
      "pattern": "nextgenroboticx.com",
      "custom_domain": true
    },
    {
      "pattern": "www.nextgenroboticx.com",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PROJECT_ACCESS",
      "id": "a043e693a55b47bd807f2ae4ddce785e"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
